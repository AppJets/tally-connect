# lex-tally-connector — environment variable template
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL password used by docker-compose.yml (Gap 21+29)
# docker-compose substitutes ${POSTGRES_PASSWORD} from this file.
POSTGRES_PASSWORD=change_me_before_use

# Database connection string for the NestJS sync server
DATABASE_URL=postgresql://lex_tally:change_me_before_use@localhost:5433/lex_tally_db

# Tally Sync Server
PORT=3600
TALLY_API_KEY=change_me_before_use

# Optional: set to "production" on staging/prod
NODE_ENV=development

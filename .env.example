# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
SERVICE_NAME=lex-tally-sync-service

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=lex_tally
DB_PASSWORD=your_strong_password
DB_NAME=lex_tally_db
DB_SYNCHRONIZE=false          # Always false in production; use migrations
DB_LOGGING=false

# ─── Redis (BullMQ) ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── API Credentials ─────────────────────────────────────────────────────────
# Secret used to HMAC-sign generated api_secrets before storing hash
API_SECRET_SALT_ROUNDS=12

# ─── Internal Activation Webhook Secret ──────────────────────────────────────
# The existing Lex app signs its activation webhook with this shared secret.
# This service verifies the HMAC-SHA256 signature on X-Lex-Signature header.
ACTIVATION_WEBHOOK_SECRET=replace_with_strong_random_string

# ─── Queue ───────────────────────────────────────────────────────────────────
SYNC_QUEUE_CONCURRENCY=10
SYNC_JOB_ATTEMPTS=3
